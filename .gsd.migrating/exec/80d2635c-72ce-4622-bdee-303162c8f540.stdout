352:export function megaStoneNameForBaseId(baseId: number): ItemName | undefined {
    384: 'rayquaza-ite',
    428: 'lopunny-ite',
    445: 'garchomp-ite',
    448: 'lucario-ite',
    460: 'abomasnow-ite',
    475: 'gallade-ite',
